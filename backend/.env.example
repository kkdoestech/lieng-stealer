# Environment variables read by the backend (app.py). Copy to backend/.env for local use;
# .env files are git-ignored, so real keys stay out of the repository.
# Every variable is optional; the value shown is the default.

# Optional: enables real LLM commentary on /api/analyze (otherwise a rule-based answer is used).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TIMEOUT=15

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-client limit for /api/analyze, and where the limiter keeps its counters.
ANALYZE_RATE_LIMIT=10 per minute
RATELIMIT_STORAGE_URI=memory://

# Development server address (python app.py). Use HOST=0.0.0.0 to expose it on your network.
HOST=127.0.0.1
PORT=5000
