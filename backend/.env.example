# Environment variables read by the backend (app.py). Every one is optional; the value shown is
# the default. Nothing loads this file automatically: copy it to backend/.env (git-ignored, so real
# keys stay out of the repository), then export it in your shell before starting the server:
#     set -a; . ./.env; set +a; python app.py
# On a hosting platform, set the same names in its environment settings instead.

# Optional: enables real LLM commentary on /api/analyze (otherwise a rule-based answer is used).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TIMEOUT=15

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-client limit for /api/analyze, where the limiter keeps its counters (memory:// counts per
# worker; use redis://… for one shared count), and a switch to turn it off.
ANALYZE_RATE_LIMIT="10 per minute"
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true

# Reverse proxies in front of the app whose X-Forwarded-For header to trust. Behind a hosting
# proxy, set 1 so the rate limit counts each visitor instead of the proxy.
PROXY_FIX_X_FOR=0

# The betting advice policy. The rungs are shares of the pot, min_edge_ratio is the EV floor a bet
# must clear (as a share of the pot) in the centre cell and in the worst fold-rate cell, and the
# equity gates decide how big a bet the win rate allows. A bad combination stops the app at start-up.
ADVICE_SMALL_FRACTION=0.33
ADVICE_LARGE_FRACTION=0.75
ADVICE_ALL_IN_FRACTION=1.0
ADVICE_MIN_EDGE_RATIO=0.05
ADVICE_ALL_IN_MIN_EQUITY=0.85
ADVICE_LARGE_MIN_EQUITY=0.5
ADVICE_VALUE_EQUITY_FLOOR=0.55
ADVICE_BLUFF_EQUITY_CEILING=0.45
ADVICE_FOLD_STEP=0.1

# Development server address (python app.py). Use HOST=0.0.0.0 to expose it on your network.
HOST=127.0.0.1
PORT=5000
